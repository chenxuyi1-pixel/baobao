# 默认关闭真实接口，保持比赛 Mock 兜底
BAOBAO_MODE=demo
VITE_USE_REAL_API=false
PORT=4173

# 豆包 Ark 文本对话（真实值只填写到本机 .env.local，不要提交）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=doubao-seed-2-0-lite
ARK_TIMEOUT_MS=20000

# 豆包实时语音全双工（WebSocket Realtime，真实值只填写到本机 .env.local）
DOUBAO_REALTIME_API_KEY=
DOUBAO_REALTIME_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue

# 豆包语音 TTS（与 Ark 文本 Key 可能不是同一套凭证）
DOUBAO_TTS_API_KEY=
# 若控制台是旧版语音应用鉴权，则改填以下两项（API Key 与旧版二选一）
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_TIMEOUT_MS=20000

# 兼容旧版语音服务配置（只有控制台明确要求时填写）
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
ARK_ENDPOINT_ID=

# TTS 角色音色
TTS_VOICE_NEUTRAL=zh_female_qingchezizi_uranus_bigtts
TTS_VOICE_MAMA=zh_female_wenroumama_uranus_bigtts
TTS_VOICE_YINGJIE=zh_female_qingchezizi_uranus_bigtts
TTS_VOICE_DUOMI=ICL_zh_female_keainvsheng_tob
